import pytest

from core.level import parse_level
from core.monster import Chase, Monster, Patrol, Search, Situation

LEVEL = parse_level("""
#########
#.......#
#P..#..M#
#.......#
#EFG..N.#
#########
""")

SEEN_WITH_LIGHT = Situation(player_cell=(1, 2), player_running=False, flashlight_on=True)
IN_DARK_WALKING = Situation(player_cell=(1, 2), player_running=False, flashlight_on=False)
RUNNING_BEHIND_WALL = Situation(player_cell=(2, 1), player_running=True, flashlight_on=False)
HIDDEN = Situation(player_cell=(4, 1), player_running=False, flashlight_on=False)


def make_monster(**senses):
    return Monster(LEVEL, start=(2, 7), patrol_route=[(2, 7), (4, 7)], **senses)


def test_monster_starts_patrolling():
    assert isinstance(make_monster().state, Patrol)


def test_monster_chases_a_player_holding_a_light():
    monster = make_monster()
    monster.step(SEEN_WITH_LIGHT)
    assert isinstance(monster.state, Chase)


def test_darkness_hides_a_distant_walking_player():
    monster = make_monster()
    monster.step(IN_DARK_WALKING)
    assert isinstance(monster.state, Patrol)


def test_monster_hears_running_through_a_wall():
    monster = make_monster()
    monster.step(RUNNING_BEHIND_WALL)
    assert isinstance(monster.state, Chase)


def test_monster_searches_when_it_loses_the_player():
    monster = make_monster(sight_in_dark=0)
    monster.step(SEEN_WITH_LIGHT)
    monster.step(HIDDEN)
    assert isinstance(monster.state, Search)


def test_monster_returns_to_patrol_after_searching():
    monster = make_monster(sight_in_dark=0)
    monster.step(SEEN_WITH_LIGHT)
    for _ in range(30):
        monster.step(HIDDEN)
    assert isinstance(monster.state, Patrol)


def test_each_step_moves_to_an_adjacent_cell():
    monster = make_monster()
    start = monster.cell
    new_cell = monster.step(SEEN_WITH_LIGHT)
    assert abs(new_cell[0] - start[0]) + abs(new_cell[1] - start[1]) == 1


def test_patrol_route_through_a_wall_raises():
    with pytest.raises(ValueError, match="mur"):
        Monster(LEVEL, start=(2, 7), patrol_route=[(2, 4)])


def test_empty_patrol_route_raises():
    with pytest.raises(ValueError):
        Monster(LEVEL, start=(2, 7), patrol_route=[])

def test_is_chasing_reflects_the_current_state():
    monster = make_monster()
    assert not monster.is_chasing
    monster.step(SEEN_WITH_LIGHT)
    assert monster.is_chasing